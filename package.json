{
  "name": "rekenwereld",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "Nederlandstalige reken-PWA voor groep 3 (iPad).",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:pages": "cross-env BASE_PATH=/RekenWereld/ npm run build",
    "preview": "vite preview",
    "preview:pages": "npm run build:pages && vite preview --base /RekenWereld/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "cross-env": "^7.0.3",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  }
}
